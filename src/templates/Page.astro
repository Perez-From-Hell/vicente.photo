---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail } = entry.data;
const currentLang = getLangFromUrl(Astro.url);
---

<Layout title={title} description={description} lang={currentLang}>

  <article class={`post-content ${thumbnail ? '' : 'no-image'}`}>
    {/* Title and description hidden
    <header class="post-content-header">
      <h1 class="post-content-title">{title}</h1>
    </header>

    {description && (
      <p class="post-content-excerpt">{description}</p>
    )}
    */}

    {thumbnail && (
      <div class="post-content-image">
        <img src={thumbnail} class="kg-image" alt={title} />
      </div>
    )}

    <div class="post-content-body">
      <Content />
    </div>

    <footer class="post-content-footer">
    </footer>
  </article>
</Layout>
