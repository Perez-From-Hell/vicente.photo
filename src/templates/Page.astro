---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail } = entry.data;
const currentLang = getLangFromUrl(Astro.url);
---

<Layout title={title} description={description} lang={currentLang}>
  {title && (
    <header class="page-head">
      <h1 class="page-head-title">{title}</h1>
      {description && (
        <p class="page-head-description">{description}</p>
      )}
    </header>
  )}

  <article class={`post-content ${thumbnail ? '' : 'no-image'}`}>

    {thumbnail && (
      <div class="post-content-image">
        <img src={thumbnail} class="kg-image" alt={title} />
      </div>
    )}

    <div class="post-content-body">
      <Content />
    </div>

    <footer class="post-content-footer">
    </footer>
  </article>
</Layout>
