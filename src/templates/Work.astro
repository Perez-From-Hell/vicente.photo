---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'> | CollectionEntry<'news'> | CollectionEntry<'sold'>;
  next?: any;
  prev?: any;
  baseSlug?: string; // e.g. 'work'
}

const { entry, next, prev, baseSlug } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail } = entry.data;

const currentLang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);

const getEntryPath = (e: any) => {
  const cleanSlug = e.slug.replace(/^(es|en)\//, '');
  return translatePath(`/${baseSlug}/${cleanSlug}`);
};
---

<Layout title={title} description={description} lang={currentLang}>
  <article class={`post-content ${thumbnail ? '' : 'no-image'}`}>
    {title && (
      <header class="post-content-header" style="text-align: center; margin-bottom: 2rem;">
        <h1 class="post-content-title" style="font-size: 3.4rem; font-weight: 400; margin-bottom: 0.5rem;">{title}</h1>
      </header>
    )}

    {description && (
      <p class="post-content-excerpt">{description}</p>
    )}

    {thumbnail && (
      <div class="post-content-image">
        <img src={thumbnail} class="kg-image" alt={title} />
      </div>
    )}

    <div class="post-content-body">
      <Content />
    </div>

    <div class="post-link">
      <div>
        {next && (
            <a style="display: flex; align-items: center; color: var(--color-base, #131313); font-size: 2rem;" href={getEntryPath(next)}>
               <span>&larr; {next.data.title}</span>
            </a>
        )}
      </div>
      <div>
        {prev && (
            <a style="display: flex; align-items: center; color: var(--color-base, #131313); font-size: 2rem;" href={getEntryPath(prev)}>
               <span>{prev.data.title} &rarr;</span>
            </a>
        )}
      </div>
    </div>

  </article>
</Layout>

