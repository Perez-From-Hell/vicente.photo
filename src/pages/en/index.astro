---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Fetch all collections for English
const allPages = await getCollection('pages', entry => entry.slug.startsWith('en/'));
const allNews = await getCollection('news', entry => entry.slug.startsWith('en/'));
const allWork = await getCollection('work', entry => entry.slug.startsWith('en/'));
const allSold = await getCollection('sold', entry => entry.slug.startsWith('en/'));

// Combine for filtering
const allContent = [...allPages, ...allNews, ...allWork, ...allSold];

// Filter for pagetype containing 'main' and sort by number
const posts = allContent.filter(item => {
    return item.data.pagetype && item.data.pagetype.includes('main');
}).sort((a, b) => {
    const numA = a.data.number || 9999;
    const numB = b.data.number || 9999;
    return numA - numB;
});

// Get index-page metadata (from pages collection)
const indexPage = allPages.find(p => p.slug === 'en/index');
const title = indexPage?.data.title || 'VICENTE PEREZ ROBLES';
const description = indexPage?.data.description;

let postCounter = 0;
---

<Layout title={title} description={description} lang="en">
    <div class="post-feed">
        {posts.map((post) => {
            postCounter++;
            const cleanSlug = post.slug.replace(/^en\//, '');
            let slug = cleanSlug;
            if (post.collection === 'work') slug = `work/${cleanSlug}`;
            if (post.collection === 'news') slug = `news/${cleanSlug}`;
            if (post.collection === 'sold') slug = `sold/${cleanSlug}`;

            return (
                <PostCard
                    count={postCounter}
                    post={post}
                    slug={slug}
                />
            );
        })}
    </div>
</Layout>
